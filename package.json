{
  "name": "semantic-network-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ${API_URL:-http://localhost:8000}/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@react-sigma/core": "^6.0.0",
    "@tanstack/react-query": "^5.105.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sigma": "^4.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "graphology-types": "^0.24.8",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
